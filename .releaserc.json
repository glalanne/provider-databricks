{
  "branches": [
    "main",
    {
      "name": "alpha",
      "prerelease": true
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    {
      "preset": "eslint",
      "releaseRules": [
        {
          "tag": "Breaking",
          "release": "major"
        },
        {
          "tag": "Build",
          "release": "minor"
        },
        {
          "tag": "Chore",
          "release": "minor"
        },
        {
          "tag": "Fix",
          "release": "patch"
        },
        {
          "tag": "New",
          "release": "minor"
        },
        {
          "tag": "Update",
          "release": "minor"
        },
        {
          "tag": "Upgrade",
          "release": "minor"
        }
      ]
    },
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": []
      }
    ]
  ]
}